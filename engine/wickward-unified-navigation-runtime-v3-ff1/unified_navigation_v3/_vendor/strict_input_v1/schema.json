  "serialization_max_bytes": 16777216,
  "shape_limits": "Unchanged bounded-recommendation JSON shape limits, also applied to strict evaluator; JSON serializable only.",
  "validation_semantics": "Closed keys and provided values checked before filtering; missing required fields and relational/operational checks delegated unchanged. Only provenance is extensible; three named existing ledger arrays remain operational in bridge/partial API.",
  "wrapper_options": {
    "evaluate_sequence": {
      "complete_remaining": {
        "type": "boolean"
      },
      "forecast_provider": {
        "type": "external_provider"
      }
    },
    "recommend": {
      "wall_time_budget_seconds": {
        "maximum": 3,
        "minimum": 0.001,
        "nullable": false,
        "type": "number"
      }
    },
    "recommend_required_recovery": {
